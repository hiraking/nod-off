<?xml version="1.0" encoding="utf-8"?>
<!--
  アプリのアイコンの背景（DESIGN.md「ロゴ」）。
  #1B2247（0%）→ #0A0C18（55%）→ #04050A（100%）の放射グラデーション。中心は右上（横 75%・縦 10%）。
  半径は中心からいちばん遠い角（左下）までの距離（約 126.5）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="81"
                android:centerY="10.8"
                android:gradientRadius="126.5">
                <item android:offset="0" android:color="#FF1B2247" />
                <item android:offset="0.55" android:color="#FF0A0C18" />
                <item android:offset="1" android:color="#FF04050A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
